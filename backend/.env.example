PORT=4000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3000
AI_SERVICE_SECRET=
DASHBOARD_WS_SECRET=
DETECTION_PERSIST_INTERVAL_MS=60000
DETECTION_LIVE_WINDOW_MS=120000
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Enable DSS automation only when every DSS variable is set.
DSS_BASE_URL=https://your-dss-host:443
DSS_USERNAME=
DSS_PASSWORD=
DSS_CHANNEL_ID=1000001$1$0$0
DSS_CLIENT_MAC=
DSS_LOGIN_TYPE=2
DSS_TLS_REJECT_UNAUTHORIZED=true
DSS_KEEPALIVE_INTERVAL_MS=20000
DSS_TOKEN_REFRESH_INTERVAL_MS=1200000

# Railway private RTSP destination, including publisher credentials in production.
MEDIAMTX_PUBLISH_URL=rtsp://relay-publisher:URL_ENCODED_PASSWORD@mediamtx.railway.internal:8554/mbs-kdn-c1
# Internal HTTP endpoint used by the authenticated Safari HLS proxy.
MEDIAMTX_HLS_INTERNAL_URL=http://mediamtx.railway.internal:8888
MEDIAMTX_PUBLISH_USER=relay-publisher
MEDIAMTX_PUBLISH_PASSWORD=
MEDIAMTX_AI_USER=vast-reader
MEDIAMTX_AI_PASSWORD=
FFMPEG_PATH=ffmpeg

# MBS-KDN-C1 outputs H.265; transcode to H.264 for Chrome-compatible HLS.
# This costs additional Railway CPU.
STREAM_TRANSCODE_H264=true
